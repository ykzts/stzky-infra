{
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "Grafana.grafana-alloy"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:3.1.0": {
      "moby": false,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1.4.3": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/daemon.json,target=/etc/docker/daemon.json,type=bind,readonly",
    "source=stzky-infra-claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "name": "stzky infra",
  "postCreateCommand": "./scripts/bootstrap.sh",
  "postStartCommand": "./scripts/prune-docker-images.sh"
}
